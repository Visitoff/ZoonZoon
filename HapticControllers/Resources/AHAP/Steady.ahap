{
  "Version": 1.0,
  "Metadata": {
    "Project": "ZoonZoon Vibrator",
    "Created": "13 April 2026",
    "Description": "Steady continuous vibration at constant intensity"
  },
  "Pattern": [
    {
      "Event": {
        "Time": 0.0,
        "EventType": "HapticContinuous",
        "EventDuration": 2.0,
        "EventParameters": [
          { "ParameterID": "HapticIntensity", "ParameterValue": 0.8 },
          { "ParameterID": "HapticSharpness", "ParameterValue": 0.5 }
        ]
      }
    }
  ]
}
