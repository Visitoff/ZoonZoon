{
  "Version": 1.0,
  "Metadata": {
    "Project": "ZoonZoon Vibrator",
    "Created": "13 April 2026",
    "Description": "Gradual escalation with sharp drop and repeat"
  },
  "Pattern": [
    {
      "ParameterCurve": {
        "ParameterID": "HapticIntensityControl",
        "Time": 0.0,
        "ParameterCurveControlPoints": [
          { "Time": 0.0, "ParameterValue": 0.3 },
          { "Time": 0.4, "ParameterValue": 0.5 },
          { "Time": 0.8, "ParameterValue": 0.7 },
          { "Time": 1.2, "ParameterValue": 0.9 },
          { "Time": 1.5, "ParameterValue": 1.0 },
          { "Time": 1.55, "ParameterValue": 0.3 },
          { "Time": 2.0, "ParameterValue": 0.5 }
        ]
      }
    },
    {
      "Event": {
        "Time": 0.0,
        "EventType": "HapticContinuous",
        "EventDuration": 2.0,
        "EventParameters": [
          { "ParameterID": "HapticIntensity", "ParameterValue": 0.9 },
          { "ParameterID": "HapticSharpness", "ParameterValue": 0.6 }
        ]
      }
    }
  ]
}
