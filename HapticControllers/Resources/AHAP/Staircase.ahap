          { "Time": 0.0, "ParameterValue": 0.3 },
          { "Time": 0.3, "ParameterValue": 0.3 },
          { "Time": 0.31, "ParameterValue": 0.5 },
          { "Time": 0.6, "ParameterValue": 0.5 },
          { "Time": 0.61, "ParameterValue": 0.7 },
          { "Time": 0.9, "ParameterValue": 0.7 },
          { "Time": 0.91, "ParameterValue": 0.9 },
          { "Time": 1.2, "ParameterValue": 0.9 },
          { "Time": 1.21, "ParameterValue": 1.0 },
          { "Time": 1.5, "ParameterValue": 1.0 },
          { "Time": 1.51, "ParameterValue": 0.3 },
          { "Time": 2.0, "ParameterValue": 0.3 }
        ]
      }
    },
    {
      "Event": {
        "Time": 0.0,
        "EventType": "HapticContinuous",
