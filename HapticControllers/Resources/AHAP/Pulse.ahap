{
  "Version": 1.0,
  "Metadata": {
    "Project": "ZoonZoon Vibrator",
    "Created": "13 April 2026",
    "Description": "Slow pulsation with smooth on/off transitions"
  },
  "Pattern": [
    {
      "ParameterCurve": {
        "ParameterID": "HapticIntensityControl",
        "Time": 0.0,
        "ParameterCurveControlPoints": [
          { "Time": 0.0, "ParameterValue": 0.0 },
          { "Time": 0.3, "ParameterValue": 1.0 },
          { "Time": 0.7, "ParameterValue": 1.0 },
          { "Time": 1.0, "ParameterValue": 0.0 },
          { "Time": 1.3, "ParameterValue": 0.0 },
          { "Time": 1.6, "ParameterValue": 1.0 },
          { "Time": 2.0, "ParameterValue": 1.0 }
        ]
      }
    },
    {
      "Event": {
        "Time": 0.0,
        "EventType": "HapticContinuous",
        "EventDuration": 2.0,
        "EventParameters": [
          { "ParameterID": "HapticIntensity", "ParameterValue": 0.8 },
          { "ParameterID": "HapticSharpness", "ParameterValue": 0.3 }
        ]
      }
    }
  ]
}
